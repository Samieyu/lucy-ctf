# -----------------------------------------------------------------------------
# Lucy CTF - Environment Variables
# -----------------------------------------------------------------------------

# PostgreSQL Database
POSTGRES_USER=lucyctf
POSTGRES_PASSWORD=lucyctf_secure_password
POSTGRES_DB=lucyctf

# Backend Configuration
PORT=4000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
JWT_SECRET=super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars
FRONTEND_URL=http://localhost:3000
GROQ_API_KEY=

# Frontend Configuration
BACKEND_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
